@page
@model RecruitCatFieldao.Pages.CandidatePages.IndexModel

@{
    ViewData["Title"] = "All Candidates";
}

<h1>All Candidates</h1>

<p>
    <a asp-page="Create">Add a Candidate</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Candidate[0].FullName)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Candidate[0].IsAvailable)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Candidate[0].TargetSalary)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Candidate[0].Company)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Candidate[0].JobTitle)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Candidate[0].Industry)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model.Candidate) {
        <tr>
            <td>
                @Html.DisplayFor(model => item.FullName)
            </td>
            <td>
                @if (item.IsAvailable)
                {
                    <span class="badge text-bg-success">Available</span>
                }
                else
                {
                    <span class="badge text-bg-secondary">Unavailable</span>
                }
            </td>
            <td>
                @item.TargetSalary.ToString("C2")
            </td>
            <td>
                    @if (string.IsNullOrEmpty(item.Company.Name))
                    {
                        <span class="badge text-bg-secondary">No Company</span>
                    }
                    else
                    {
                        @Html.DisplayFor(model => item.Company.Name)
                    }
            </td>
            <td>
                @Html.DisplayFor(model => item.JobTitle.Title)
            </td>
            <td>
                @Html.DisplayFor(model => item.Industry.Name)
            </td>
            <td>
                <a asp-page="./Edit" asp-route-id="@item.Id">Edit</a> |
                <a asp-page="./Details" asp-route-id="@item.Id">Details</a> |
                <a asp-page="./Delete" asp-route-id="@item.Id">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
