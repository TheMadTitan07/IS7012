@page
@model RecruitCatFieldao.Pages.CandidatePages.EditModel

@{
    ViewData["Title"] = "Modify Candidate";
}

<h1>Modify @Model.Candidate.FullName</h1>

<hr />
<div class="row">
    <div class="col-md-4">
        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="Candidate.Id" />
            <div class="form-group">
                <label asp-for="Candidate.FirstName" class="control-label"></label>
                <input asp-for="Candidate.FirstName" class="form-control" />
                <span asp-validation-for="Candidate.FirstName" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Candidate.MiddleName" class="control-label"></label>
                <input asp-for="Candidate.MiddleName" class="form-control" />
                <span asp-validation-for="Candidate.MiddleName" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Candidate.LastName" class="control-label"></label>
                <input asp-for="Candidate.LastName" class="form-control" />
                <span asp-validation-for="Candidate.LastName" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Candidate.IsAvailable" class="control-label"></label>
                <input asp-for="Candidate.IsAvailable" class="form-check-input" />
                <span asp-validation-for="Candidate.IsAvailable" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Candidate.CurrentSalary" class="control-label"></label>
                <input asp-for="Candidate.CurrentSalary" class="form-control" />
                <span asp-validation-for="Candidate.CurrentSalary" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Candidate.TargetSalary" class="control-label"></label>
                <input asp-for="Candidate.TargetSalary" class="form-control" />
                <span asp-validation-for="Candidate.TargetSalary" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Candidate.StartDate" class="control-label"></label>
                <input asp-for="Candidate.StartDate" class="form-control" />
                <span asp-validation-for="Candidate.StartDate" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Candidate.PhoneNumber" class="control-label"></label>
                <input asp-for="Candidate.PhoneNumber" class="form-control" />
                <span asp-validation-for="Candidate.PhoneNumber" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Candidate.EmailAddress" class="control-label"></label>
                <input asp-for="Candidate.EmailAddress" class="form-control" />
                <span asp-validation-for="Candidate.EmailAddress" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Candidate.Company.Name" class="control-label"></label>
                <select asp-for="Candidate.CompanyId" asp-items="ViewBag.CompanyId" class="form-control"></select>
                <span asp-validation-for="Candidate.CompanyId" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Candidate.JobTitle.Title" class="control-label"></label>
                <select asp-for="Candidate.JobTitleId" asp-items="ViewBag.JobTitleId" class="form-control"></select>
                <span asp-validation-for="Candidate.JobTitleId" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Candidate.Industry.Name" class="control-label"></label>
                <select asp-for="Candidate.IndustryId" asp-items="ViewBag.IndustryId" class="form-control"></select>
                <span asp-validation-for="Candidate.IndustryId" class="text-danger"></span>
            </div>
            <div class="form-group mt-4 mb-5">
                <input type="submit" value="Save" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div style="margin-bottom:60px;">
    <a asp-page="./Index">Back to Candidates</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
