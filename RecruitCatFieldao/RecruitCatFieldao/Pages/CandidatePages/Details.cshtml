@page
@model RecruitCatFieldao.Pages.CandidatePages.DetailsModel

@{
    ViewData["Title"] = "Candidate Details";
}

<h1>Details for @Model.Candidate.FullName</h1>

<div>
    <hr />
    <dl class="row">
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Candidate.FirstName)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Candidate.FirstName)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Candidate.MiddleName)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Candidate.MiddleName)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Candidate.LastName)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Candidate.LastName)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Candidate.IsAvailable)
        </dt>
        <dd class = "col-sm-10">
            @if (Model.Candidate.IsAvailable)
            {
                <span class="badge text-bg-secondary">Unavailable</span>
            }
            else
            {
                <span class="badge text-bg-success">Available</span>
            }
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Candidate.CurrentSalary)
        </dt>
        <dd class = "col-sm-10">
            @if (Model.Candidate.CurrentSalary == null)
            {
                <span class="badge text-bg-secondary">N/A</span>
            }
            else
            {
                @(Model.Candidate.CurrentSalary.Value.ToString("C2"))
            }
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Candidate.TargetSalary)
        </dt>
        <dd class = "col-sm-10">
            @(Model.Candidate.TargetSalary.ToString("C2"))
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Candidate.StartDate)
        </dt>
        <dd class = "col-sm-10">
            @if (Model.Candidate.StartDate == null)
            {
                <span class="badge text-bg-secondary">N/A</span>
            }
            else
            {
                @Html.DisplayFor(model => model.Candidate.StartDate)
            }
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Candidate.PhoneNumber)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Candidate.PhoneNumber)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Candidate.EmailAddress)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Candidate.EmailAddress)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Candidate.Company.Name)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Candidate.Company.Name)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Candidate.JobTitle.Title)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Candidate.JobTitle.Title)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Candidate.Industry.Name)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Candidate.Industry.Name)
        </dd>
    </dl>
</div>
<div>
    <a asp-page="./Edit" asp-route-id="@Model.Candidate.Id">Edit</a> |
    <a asp-page="./Index">Back to Candidates</a>
</div>
