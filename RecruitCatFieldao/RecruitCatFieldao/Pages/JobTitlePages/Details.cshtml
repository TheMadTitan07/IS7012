@page
@model RecruitCatFieldao.Pages.JobTitlePages.DetailsModel

@{
    ViewData["Title"] = "Position Details";
}

<h1>Details for @Model.JobTitle.Title</h1>

<div>
    <hr />
    <dl class="row">
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.JobTitle.Title)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.JobTitle.Title)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.JobTitle.MinimumSalary)
        </dt>
        <dd class = "col-sm-10">
            @(Model.JobTitle.MinimumSalary.ToString("C2"))
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.JobTitle.MaximumSalary)
        </dt>
        <dd class = "col-sm-10">
            @(Model.JobTitle.MaximumSalary.ToString("C2"))
        </dd>
    </dl>
</div>
@if (Model.JobTitle.Candidates.Any())
{
    <div class="mb-3">
        <h4>Candidates for @Model.JobTitle.Title:</h4>
        <table class="table table-bordered">
            <thead>
                <tr>
                    <th>@Html.DisplayNameFor(model => model.JobTitle.Candidates[0].FullName) </th>
                    <th>@Html.DisplayNameFor(model => model.JobTitle.Candidates[0].PhoneNumber) </th>
                    <th>@Html.DisplayNameFor(model => model.JobTitle.Candidates[0].EmailAddress) </th>
                    <th>@Html.DisplayNameFor(model => model.JobTitle.Candidates[0].StartDate) </th>
                    <th>@Html.DisplayNameFor(model => model.JobTitle.Candidates[0].TargetSalary) </th>
                    <th>@* placeholder for details hyperlink *@</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.JobTitle.Candidates)
                {
                    <tr>
                        <td>@Html.DisplayFor(modelItem => item.FullName)</td>
                        <td>@Html.DisplayFor(modelItem => item.PhoneNumber)</td>
                        <td>@Html.DisplayFor(modelItem => item.EmailAddress)</td>
                        <td>@Html.DisplayFor(modelItem => item.StartDate)</td>
                        <td>@Html.DisplayFor(modelItem => item.TargetSalary)</td>
                        <td>
                            <a asp-page="/CandidatePages/Details" asp-route-id="@item.Id">Details</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
        <strong>@Model.JobTitle.Candidates.Count Candidates Found</strong>
    </div>
}
else
{
    <div class="alert alert-warning">No candidates found for @Model.JobTitle.Title</div>
}
<div>
    <a asp-page="./Edit" asp-route-id="@Model.JobTitle.Id">Edit</a> |
    <a asp-page="./Index">Back to Positions</a>
</div>
