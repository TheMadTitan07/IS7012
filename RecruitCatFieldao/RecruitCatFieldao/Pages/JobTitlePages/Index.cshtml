@page
@model RecruitCatFieldao.Pages.JobTitlePages.IndexModel

@{
    ViewData["Title"] = "All Positions";
}

<h1>All Positions</h1>

<p>
    <a asp-page="Create">Add a Position</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.JobTitle[0].Title)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.JobTitle[0].MinimumSalary)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.JobTitle[0].MaximumSalary)
            </th>
            <th>
                Total Candidates
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model.JobTitle) {
        <tr>
            <td>
                @Html.DisplayFor(model => item.Title)
            </td>
            <td>
                @item.MinimumSalary.ToString("C2")
            </td>
            <td>
                @item.MaximumSalary.ToString("C2")
            </td>
            <td>
                    @if (item.Candidates.Any())
                    {
                        @(item.Candidates?.Count ?? 0);
                    }
                    else
                    {
                        <span class="badge text-bg-warning">No Candidates</span>
                    }
                </td>
            <td>
                <a asp-page="./Edit" asp-route-id="@item.Id">Edit</a> |
                <a asp-page="./Details" asp-route-id="@item.Id">Details</a> |
                <a asp-page="./Delete" asp-route-id="@item.Id">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
