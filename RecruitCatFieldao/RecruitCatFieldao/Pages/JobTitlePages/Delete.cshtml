@page
@model RecruitCatFieldao.Pages.JobTitlePages.DeleteModel

@{
    ViewData["Title"] = "Delete Position";
}

<h1>Delete @Model.JobTitle.Title</h1>

<div class="alert alert-warning mb-2">
    Warning - Deleting a position cannot be undone!
</div>

<div>
    <hr />
    <dl class="row">
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.JobTitle.Title)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.JobTitle.Title)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.JobTitle.MinimumSalary)
        </dt>
        <dd class = "col-sm-10">
            @(Model.JobTitle.MinimumSalary.ToString("C2"))
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.JobTitle.MaximumSalary)
        </dt>
        <dd class = "col-sm-10">
            @(Model.JobTitle.MaximumSalary.ToString("C2"))
        </dd>
    </dl>
    <form method="post">
        <input type="hidden" asp-for="JobTitle.Id" />
        <input type="submit" value="Delete" class="btn btn-danger" /> |
        <a asp-page="./Index">Back to Positions</a>
    </form>
</div>
