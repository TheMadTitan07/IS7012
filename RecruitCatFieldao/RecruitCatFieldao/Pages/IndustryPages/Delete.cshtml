@page
@model RecruitCatFieldao.Pages.IndustryPages.DeleteModel

@{
    ViewData["Title"] = "Delete Industry";
}

<h1>Delete @Model.Industry.Name</h1>

<div class="alert alert-warning mb-2">
    Warning - Deleting an industry cannot be undone!
</div>

<div>
    <hr />
    <dl class="row">
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Industry.Name)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Industry.Name)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Industry.Description)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Industry.Description)
        </dd>
    </dl>
    <form method="post">
        <input type="hidden" asp-for="Industry.Id" />
        <input type="submit" value="Delete" class="btn btn-danger" /> |
        <a asp-page="./Index">Back to Industries</a>
    </form>
</div>
