@page
@model RecruitCatFieldao.Pages.IndustryPages.DetailsModel

@{
    ViewData["Title"] = "Industry Details";
}

<h1>Details for @Model.Industry.Name</h1>

<div>
    <hr />
    <dl class="row">
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Industry.Name)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Industry.Name)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Industry.Description)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Industry.Description)
        </dd>
    </dl>
</div>
@if (Model.Industry.Companies.Any())
{
    <div class="mb-3">
        <h4>Companies for @Model.Industry.Name:</h4>
        <table class="table table-bordered">
            <thead>
                <tr>
                    <th>@Html.DisplayNameFor(model => model.Industry.Companies[0].Name) </th>
                    <th>@Html.DisplayNameFor(model => model.Industry.Companies[0].JobTitle) </th>
                    <th>@Html.DisplayNameFor(model => model.Industry.Companies[0].Phone) </th>
                    <th>@Html.DisplayNameFor(model => model.Industry.Companies[0].Email) </th>
                    <th>@* placeholder for details hyperlink *@</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.Industry.Companies)
                {
                    <tr>
                        <td>@Html.DisplayFor(modelItem => item.Name)</td>
                        <td>@Html.DisplayFor(modelItem => item.JobTitle)</td>
                        <td>@Html.DisplayFor(modelItem => item.Phone)</td>
                        <td>@Html.DisplayFor(modelItem => item.Email)</td>
                        <td>
                            <a asp-page="/CompanyPages/Details" asp-route-id="@item.Id">Details</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
        <strong>@Model.Industry.Companies.Count Company(ies) Found</strong>
    </div>
}
else
{
    <div class="alert alert-warning">No companies found for @Model.Industry.Name</div>
}
@if (Model.Industry.Candidates.Any())
{
    <div class="mb-3">
    <h4>Candidates for @Model.Industry.Name:</h4>
    <table class="table table-bordered">
        <thead>
            <tr>
                <th>@Html.DisplayNameFor(model => model.Industry.Candidates[0].FullName) </th>
                <th>@Html.DisplayNameFor(model => model.Industry.Candidates[0].PhoneNumber) </th>
                <th>@Html.DisplayNameFor(model => model.Industry.Candidates[0].EmailAddress) </th>
                <th>@Html.DisplayNameFor(model => model.Industry.Candidates[0].StartDate) </th>
                <th>@Html.DisplayNameFor(model => model.Industry.Candidates[0].TargetSalary) </th>
                <th>@* placeholder for details hyperlink *@</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model.Industry.Candidates)
            {
                <tr>
                    <td>@Html.DisplayFor(modelItem => item.FullName)</td>
                    <td>@Html.DisplayFor(modelItem => item.PhoneNumber)</td>
                    <td>@Html.DisplayFor(modelItem => item.EmailAddress)</td>
                    <td>@Html.DisplayFor(modelItem => item.StartDate)</td>
                    <td>@Html.DisplayFor(modelItem => item.TargetSalary)</td>
                    <td>
                        <a asp-page="/CandidatePages/Details" asp-route-id="@item.Id">Details</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
    <strong>@Model.Industry.Candidates.Count Candidate(s) Found</strong>
    </div>
}
else
{
    <div class="alert alert-warning">No candidates found for @Model.Industry.Name</div>
}
<div style="margin-bottom:75px;">
    <a asp-page="./Edit" asp-route-id="@Model.Industry.Id">Edit</a> |
    <a asp-page="./Index">Back to Industries</a>
</div>
