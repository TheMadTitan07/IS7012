@page
@model RecruitCatFieldao.Pages.IndustryPages.IndexModel

@{
    ViewData["Title"] = "All Industries";
}

<h1>All Industries</h1>

<p>
    <a asp-page="Create">Add an Industry</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Industry[0].Name)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Industry[0].Description)
            </th>
            <th>
                Total Companies
            </th>
            <th>
                Total Candidates
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model.Industry) {
        <tr>
            <td>
                @Html.DisplayFor(model => item.Name)
            </td>
            <td>
                @Html.DisplayFor(model => item.Description)
            </td>
            <td>
                    @if (item.Companies.Any())
                    {
                        @(item.Companies?.Count ?? 0);
                    }
                    else
                    {
                        <span class="badge text-bg-warning">No Companies</span>
                    }
            </td>
            <td>
                    @if (item.Candidates.Any())
                    {
                        @(item.Candidates?.Count ?? 0);
                    }
                    else
                    {
                        <span class="badge text-bg-warning">No Candidates</span>
                    }
            </td>
            <td>
                <a asp-page="./Edit" asp-route-id="@item.Id">Edit</a> |
                <a asp-page="./Details" asp-route-id="@item.Id">Details</a> |
                <a asp-page="./Delete" asp-route-id="@item.Id">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
