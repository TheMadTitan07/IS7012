@page
@model RecruitCatFieldao.Pages.OurTeamModel
@{
    ViewData["Title"] = "Our Team";
}

<div class="text-center mb-4">
    <h1>Meet Team Fat Cat!</h1>
</div>

<div class="container team-cards">
    <div class="row g-3 align-items-stretch">
        <div class="col-md-4 d-flex">
            <div class="card flex-fill d-flex flex-column">
                <div class="team-img">
                    <img class="card-img-top img-fluid" src="/images/Fields_Headshot_Cropped.jpg" alt="This is an image of Fat Cat owner and CEO, Aaron Fields" />
                </div>
                <div class="card-body flex-grow-1">
                    <h5 class="card-title">Aaron Fields</h5>
                    <p>As founder and CEO, Aaron specializes in administration of the business. He is currently a student in the MS IS program at the University of Cincinnati</p>
                </div>
                <div class="card-footer text-center fw-bold bg-card-footer">
                    <a target="_blank" href="mailto:aaron.fields@fatcatsrecruiting.com" class="btn btn-sm btn-email">Email Aaron</a>
                </div>
            </div>
        </div>
        <div class="col-md-4 d-flex">
            <div class="card flex-fill d-flex flex-column">
                <div class="team-img">
                    <img class="card-img-top img-fluid" src="/images/Skywalker_Headshot.png" alt="This is an image of our IT recruiting master, Luke Skywalker" />
                </div>
                <div class="card-body flex-grow-1">
                    <h5 class="card-title">Luke Skywalker</h5>
                    <p>Luke specializes in using his instincts to find reliable candidates in IT. Reach out to Luke today for your IT needs!</p>
                </div>
                <div class="card-footer text-center fw-bold bg-card-footer">
                    <a target="_blank" href="mailto:luke.skywalker@fatcatsrecruiting.com" class="btn btn-sm btn-email">Email Luke</a>
                </div>
            </div>
        </div>
        <div class="col-md-4 d-flex">
            <div class="card flex-fill d-flex flex-column">
                <div class="team-img">
                    <img class="card-img-top img-fluid" src="/images/Riddle_Headshot.png" alt="This is an image of Business Analytics recruiting wizard, Tom Riddle!" />
                </div>
                <div class="card-body flex-grow-1">
                    <h5 class="card-title">Tom Riddle</h5>
                    <p>Tom specializes in sourcing candidates in the Business Analytics space. He'll help you find the right candidate to who can provide data driven results for your business</p>
                </div>
                <div class="card-footer text-center fw-bold bg-card-footer">
                    <a target="_blank" href="mailto:tom.riddle@fatcatsrecruiting.com" class="btn btn-sm btn-email">Email Tom</a>
                </div>
            </div>
        </div>
    </div>
</div>

