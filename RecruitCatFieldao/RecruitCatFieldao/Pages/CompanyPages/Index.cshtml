@page
@model RecruitCatFieldao.Pages.CompanyPages.IndexModel

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
    <a asp-page="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Company[0].Name)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Company[0].IsActivelyRecruiting)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Company[0].CurrentlyRecruitingPosition)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Company[0].Phone)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Company[0].Email)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Company[0].MinimumSalary)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Company[0].MaximumSalary)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Company[0].Candidates)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Company[0].Industry)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Company[0].IndustryId)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Company[0].JobTitle)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Company[0].JobTitleId)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model.Company) {
        <tr>
            <td>
                @Html.DisplayFor(model => item.Name)
            </td>
            <td>
                @Html.DisplayFor(model => item.IsActivelyRecruiting)
            </td>
            <td>
                @Html.DisplayFor(model => item.CurrentlyRecruitingPosition)
            </td>
            <td>
                @Html.DisplayFor(model => item.Phone)
            </td>
            <td>
                @Html.DisplayFor(model => item.Email)
            </td>
            <td>
                @Html.DisplayFor(model => item.MinimumSalary)
            </td>
            <td>
                @Html.DisplayFor(model => item.MaximumSalary)
            </td>
            <td>
                @Html.DisplayFor(model => item.Candidates)
            </td>
            <td>
                @Html.DisplayFor(model => item.Industry)
            </td>
            <td>
                @Html.DisplayFor(model => item.IndustryId)
            </td>
            <td>
                @Html.DisplayFor(model => item.JobTitle)
            </td>
            <td>
                @Html.DisplayFor(model => item.JobTitleId)
            </td>
            <td>
                <a asp-page="./Edit" asp-route-id="@item.Id">Edit</a> |
                <a asp-page="./Details" asp-route-id="@item.Id">Details</a> |
                <a asp-page="./Delete" asp-route-id="@item.Id">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
