@page
@model RecruitCatFieldao.Pages.CompanyPages.IndexModel

@{
    ViewData["Title"] = "All Companies";
}

<h1>All Companies</h1>

<p>
    <a asp-page="Create">Add a Company</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Company[0].Name)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Company[0].IsActivelyRecruiting)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Company[0].CurrentlyRecruitingPosition)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Company[0].Industry.Name)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Company[0].JobTitle.Title)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model.Company) {
        <tr>
            <td>
                @Html.DisplayFor(model => item.Name)
            </td>
            <td>
                    @if (item.IsActivelyRecruiting)
                    {
                        <span class="badge text-bg-success">Recruiting</span>
                    }
                    else
                    {
                        <span class="badge text-bg-secondary">Not Recruiting</span>
                    }
                </td>
            <td>
                @Html.DisplayFor(model => item.CurrentlyRecruitingPosition)
            </td>
            <td>
                @Html.DisplayFor(model => item.Industry.Name)
            </td>
            <td>
                @Html.DisplayFor(model => item.JobTitle.Title)
            </td>
            <td>
                <a asp-page="./Edit" asp-route-id="@item.Id">Edit</a> |
                <a asp-page="./Details" asp-route-id="@item.Id">Details</a> |
                <a asp-page="./Delete" asp-route-id="@item.Id">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
