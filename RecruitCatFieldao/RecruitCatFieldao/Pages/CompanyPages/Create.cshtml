@page
@model RecruitCatFieldao.Pages.CompanyPages.CreateModel

@{
    ViewData["Title"] = "Add Company";
}

<h1>Add a Company</h1>

<hr />
<div class="row">
    <div class="col-md-4">
        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group">
                <label asp-for="Company.Name" class="control-label"></label>
                <input asp-for="Company.Name" class="form-control" />
                <span asp-validation-for="Company.Name" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Company.IsActivelyRecruiting" class="control-label"></label>
                <input asp-for="Company.IsActivelyRecruiting" class="form-check-input" />
                <span asp-validation-for="Company.IsActivelyRecruiting" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Company.CurrentlyRecruitingPosition" class="control-label"></label>
                <input asp-for="Company.CurrentlyRecruitingPosition" class="form-control" />
                <span asp-validation-for="Company.CurrentlyRecruitingPosition" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Company.Phone" class="control-label"></label>
                <input asp-for="Company.Phone" class="form-control" />
                <span asp-validation-for="Company.Phone" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Company.Email" class="control-label"></label>
                <input asp-for="Company.Email" class="form-control" />
                <span asp-validation-for="Company.Email" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Company.MinimumSalary" class="control-label"></label>
                <input asp-for="Company.MinimumSalary" class="form-control" />
                <span asp-validation-for="Company.MinimumSalary" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Company.MaximumSalary" class="control-label"></label>
                <input asp-for="Company.MaximumSalary" class="form-control" />
                <span asp-validation-for="Company.MaximumSalary" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Company.Industry.Name" class="control-label"></label>
                <select asp-for="Company.IndustryId" asp-items="ViewBag.IndustryId" class="form-control"></select>
                <span asp-validation-for="Company.IndustryId" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Company.JobTitle.Title" class="control-label"></label>
                <select asp-for="Company.JobTitleId" asp-items="ViewBag.JobTitleID" class="form-control"></select>
                <span asp-validation-for="Company.JobTitleId" class="text-danger"></span>
            </div>
            <div class="form-group mt-4 mb-3">
                <input type="submit" value="Create" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div style="margin-bottom:65px;">
    <a asp-page="./Index">Back to Companies</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
