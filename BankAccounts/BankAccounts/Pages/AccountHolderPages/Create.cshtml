@page
@model BankAccounts.Pages.AccountHolderPages.CreateModel

@{
    ViewData["Title"] = "Add Account Holder";
}

<h1>Add an Account Holder</h1>

<hr />
<div class="row">
    <div class="col-md-4">
        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group">
                <label asp-for="AccountHolder.FirstName" class="control-label"></label>
                <input asp-for="AccountHolder.FirstName" class="form-control" />
                <span asp-validation-for="AccountHolder.FirstName" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="AccountHolder.MiddleName" class="control-label"></label>
                <input asp-for="AccountHolder.MiddleName" class="form-control" />
                <span asp-validation-for="AccountHolder.MiddleName" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="AccountHolder.LastName" class="control-label"></label>
                <input asp-for="AccountHolder.LastName" class="form-control" />
                <span asp-validation-for="AccountHolder.LastName" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="AccountHolder.DateOfBirth" class="control-label"></label>
                <input asp-for="AccountHolder.DateOfBirth" class="form-control" />
                <span asp-validation-for="AccountHolder.DateOfBirth" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="AccountHolder.SocialSecurityNumber" class="control-label"></label>
                <input asp-for="AccountHolder.SocialSecurityNumber" class="form-control" />
                <span asp-validation-for="AccountHolder.SocialSecurityNumber" class="text-danger"></span>
            </div>
            <div class="form-group">
                <input type="submit" value="Add" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-page="./Index">Back to Account Holders</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
