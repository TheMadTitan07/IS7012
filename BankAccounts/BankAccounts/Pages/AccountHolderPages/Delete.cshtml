@page
@model BankAccounts.Pages.AccountHolderPages.DeleteModel

@{
    ViewData["Title"] = "Delete Account Holder";
}

<h1>Delete Account Holder</h1>

<div class="alert alert-warning mb-2" role="alert">
    Warning - deleting an account holder cannot be undone!
</div>
<div>
    <hr />
    <dl class="row">
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.AccountHolder.FirstName)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.AccountHolder.FirstName)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.AccountHolder.MiddleName)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.AccountHolder.MiddleName)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.AccountHolder.LastName)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.AccountHolder.LastName)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.AccountHolder.DateOfBirth)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.AccountHolder.DateOfBirth)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.AccountHolder.SocialSecurityNumber)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.AccountHolder.SocialSecurityNumber)
        </dd>
@*         <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.AccountHolder.BankAccounts)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.AccountHolder.BankAccounts)
        </dd> *@
    </dl>
    <form method="post">
        <input type="hidden" asp-for="AccountHolder.Id" />
        <input type="submit" value="Delete" class="btn btn-danger" /> |
        <a asp-page="./Index">Back to Account Holders</a>
    </form>
</div>
