@page
@model BankAccounts.Pages.AccountHolderPages.IndexModel

@{
    ViewData["Title"] = "Bank Account Holders";
}

<h1>Bank Account Holders</h1>

<p>
    <a asp-page="Create">Add Account Holder</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.AccountHolder[0].FirstName)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.AccountHolder[0].MiddleName)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.AccountHolder[0].LastName)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.AccountHolder[0].DateOfBirth)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.AccountHolder[0].SocialSecurityNumber)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model.AccountHolder) {
        <tr>
            <td>
                @Html.DisplayFor(model => item.FirstName)
            </td>
            <td>
                @Html.DisplayFor(model => item.MiddleName)
            </td>
            <td>
                @Html.DisplayFor(model => item.LastName)
            </td>
            <td>
                @Html.DisplayFor(model => item.DateOfBirth)
            </td>
            <td>
                @Html.DisplayFor(model => item.SocialSecurityNumber)
            </td>
            <td>
                <a asp-page="./Edit" asp-route-id="@item.Id">Edit</a> |
                <a asp-page="./Details" asp-route-id="@item.Id">Details</a> |
                <a asp-page="./Delete" asp-route-id="@item.Id">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
