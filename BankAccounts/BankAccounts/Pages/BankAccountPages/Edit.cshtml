@page
@model BankAccounts.Pages.BankAccountPages.EditModel

@{
    ViewData["Title"] = "Modify Bank Account Details";
}

<h1>Modify Bank Account Details</h1>

<h4>BankAccount</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="BankAccount.Id" />
            <div class="form-group">
                <label asp-for="BankAccount.AccountNumber" class="control-label"></label>
                <input asp-for="BankAccount.AccountNumber" class="form-control" />
                <span asp-validation-for="BankAccount.AccountNumber" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="BankAccount.RoutingNumber" class="control-label"></label>
                <input asp-for="BankAccount.RoutingNumber" class="form-control" />
                <span asp-validation-for="BankAccount.RoutingNumber" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="BankAccount.CurrentBalance" class="control-label"></label>
                <input asp-for="BankAccount.CurrentBalance" class="form-control" />
                <span asp-validation-for="BankAccount.CurrentBalance" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="BankAccount.Name" class="control-label"></label>
                <input asp-for="BankAccount.Name" class="form-control" />
                <span asp-validation-for="BankAccount.Name" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="BankAccount.OpenedDate" class="control-label"></label>
                <input asp-for="BankAccount.OpenedDate" class="form-control" />
                <span asp-validation-for="BankAccount.OpenedDate" class="text-danger"></span>
            </div>
            <div class="form-group mb-3">
                <label asp-for="BankAccount.AccountHolderId" class="control-label">Account Holder</label>
                <select asp-for="BankAccount.AccountHolderId" asp-items="ViewBag.AccountHolderID" class="form-control"></select>
                <span asp-validation-for="BankAccount.AccountHolderId" class="text-danger"></span>
            </div>
            <div class="form-group">
                <input type="submit" value="Save" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-page="./Index">Back to Bank Accounts</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
