@page
@model BankAccounts.Pages.BankAccountPages.IndexModel

@{
    ViewData["Title"] = "Bank Accounts";
}

<h1>Bank Accounts</h1>

<p>
    <a asp-page="Create">Add a Bank Account</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.BankAccount[0].AccountNumber)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.BankAccount[0].RoutingNumber)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.BankAccount[0].CurrentBalance)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.BankAccount[0].Name)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.BankAccount[0].OpenedDate)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.BankAccount[0].AccountHolder)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model.BankAccount) {
        <tr>
            <td>
                @Html.DisplayFor(model => item.AccountNumber)
            </td>
            <td>
                @Html.DisplayFor(model => item.RoutingNumber)
            </td>
            <td>
                @Html.DisplayFor(model => item.CurrentBalance)
            </td>
            <td>
                @Html.DisplayFor(model => item.Name)
            </td>
            <td>
                @Html.DisplayFor(model => item.OpenedDate)
            </td>
            <td>
                @Html.DisplayFor(model => item.AccountHolder.FullName)
            </td>
            <td>
                <a asp-page="./Edit" asp-route-id="@item.Id">Edit</a> |
                <a asp-page="./Details" asp-route-id="@item.Id">Details</a> |
                <a asp-page="./Delete" asp-route-id="@item.Id">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
