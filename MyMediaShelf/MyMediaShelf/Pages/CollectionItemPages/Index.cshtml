@page
@model MyMediaShelf.Pages.CollectionItemPages.IndexModel

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
    <a asp-page="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                Collection
            </th>
            <th>
                Media Item
            </th>
            <th>
                @Html.DisplayNameFor(model => model.CollectionItem[0].MediaItem.MediaType.Type)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.CollectionItem[0].MediaItem.MediaFormat.Format)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.CollectionItem[0].DateAdded)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model.CollectionItem) {
        <tr>
            <td>
                @Html.DisplayFor(model => item.Collection.Name)
            </td>
            <td>
                @Html.DisplayFor(model => item.MediaItem.Title)
            </td>
            <td>
                @Html.DisplayFor(model => item.MediaItem.MediaType.Type)
            </td>
            <td>
                @Html.DisplayFor(model => item.MediaItem.MediaFormat.Format)
            </td>
            <td>
                @Html.DisplayFor(model => item.DateAdded)
            </td>
            <td>
                <a asp-page="./Edit" asp-route-id="@item.Id">Edit</a> |
                <a asp-page="./Details" asp-route-id="@item.Id">Details</a> |
                <a asp-page="./Delete" asp-route-id="@item.Id">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
