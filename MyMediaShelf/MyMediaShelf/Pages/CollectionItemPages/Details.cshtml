@page
@model MyMediaShelf.Pages.CollectionItemPages.DetailsModel

@{
    ViewData["Title"] = "Details";
}

<h1>Details</h1>

<div>
    <h4>CollectionItem</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.CollectionItem.Collection)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.CollectionItem.Collection.Name)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.CollectionItem.MediaItem)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.CollectionItem.MediaItem.Title)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.CollectionItem.DateAdded)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.CollectionItem.DateAdded)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.CollectionItem.IsLoaned)
        </dt>
        <dd class = "col-sm-10">
            @if (Model.CollectionItem.IsLoaned)
            {
                <span class="badge text-bg-warning">Loaned</span>
            }
            else
            {
                <span class="badge text-bg-success">Available</span>
            }
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.CollectionItem.LoanedDate)
        </dt>
        <dd class = "col-sm-10">
            @if (Model.CollectionItem.IsLoaned)
            {
                <span class="badge text-bg-secondary">N/A</span>
            }
            else
            {
                @Html.DisplayFor(model => model.CollectionItem.LoanedDate)
            }
        </dd>
    </dl>
</div>
<div>
    <a asp-page="./Edit" asp-route-id="@Model.CollectionItem.Id">Edit</a> |
    <a asp-page="./Index">Back to List</a>
</div>
