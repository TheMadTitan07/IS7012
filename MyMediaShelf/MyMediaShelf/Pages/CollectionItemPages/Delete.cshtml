@page
@model MyMediaShelf.Pages.CollectionItemPages.DeleteModel

@{
    ViewData["Title"] = "Delete";
}

<h1>Delete</h1>

<h3>Are you sure you want to delete this?</h3>
<div>
    <h4>MyMediaShelf.Models.CollectionItem</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.CollectionItem.Collection)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.CollectionItem.Collection)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.CollectionItem.MediaItem)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.CollectionItem.MediaItem)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.CollectionItem.DateAdded)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.CollectionItem.DateAdded)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.CollectionItem.IsLoaned)
        </dt>
        <dd class="col-sm-10">
            @if (Model.CollectionItem.IsLoaned)
            {
                <span class="badge text-bg-warning">Loaned</span>
            }
            else
            {
                <span class="badge text-bg-success">Available</span>
            }
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.CollectionItem.LoanedDate)
        </dt>
        <dd class="col-sm-10">
            @if (Model.CollectionItem.IsLoaned)
            {
                <span class="badge text-bg-secondary">N/A</span>
            }
            else
            {
                @Html.DisplayFor(model => model.CollectionItem.LoanedDate)
            }
        </dd>
    </dl>
    <form method="post">
        <input type="hidden" asp-for="CollectionItem.Id" />
        <input type="submit" value="Delete" class="btn btn-danger" /> |
        <a asp-page="./Index">Back to List</a>
    </form>
</div>
