@page
@model MyMediaShelf.Pages.MediaItemPages.IndexModel

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
    <a asp-page="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.MediaItem[0].Title)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.MediaItem[0].MediaType.Type)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.MediaItem[0].MediaFormat.Format)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model.MediaItem) {
        <tr>
            <td>
                @Html.DisplayFor(model => item.Title)
            </td>
            <td>
                @Html.DisplayFor(model => item.MediaType.Type)
            </td>
            <td>
                @Html.DisplayFor(model => item.MediaFormat.Format)
            </td>
            <td>
                <a asp-page="./Edit" asp-route-id="@item.Id">Edit</a> |
                <a asp-page="./Details" asp-route-id="@item.Id">Details</a> |
                <a asp-page="./Delete" asp-route-id="@item.Id">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
