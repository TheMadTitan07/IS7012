@page
@model MyMediaShelf.Pages.MediaItemPages.CreateModel

@{
    ViewData["Title"] = "Create";
}

<h1>Create</h1>

<h4>MediaItem</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group">
                <span class="text-danger">*</span>
                <label asp-for="MediaItem.Title" class="control-label"></label>
                <input asp-for="MediaItem.Title" class="form-control" aria-required="true" />
                <span asp-validation-for="MediaItem.Title" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="MediaItem.MediaType.Type" class="control-label"></label>
                <select asp-for="MediaItem.MediaTypeID" asp-items="ViewBag.MediaTypeID" class="form-control"></select>
                <span asp-validation-for="MediaItem.MediaTypeID" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="MediaItem.MediaFormat.Format" class="control-label"></label>
                <select asp-for="MediaItem.MediaFormatId" asp-items="ViewBag.MediaFormatID" class="form-control"></select>
                <span asp-validation-for="MediaItem.MediaFormatId" class="text-danger"></span>
            </div>
            <div class="form-group">
                <input type="submit" value="Save" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-page="./Index">Back to List</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
