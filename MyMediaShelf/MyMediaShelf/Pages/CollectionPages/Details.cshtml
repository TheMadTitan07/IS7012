@page
@model MyMediaShelf.Pages.CollectionPages.DetailsModel

@{
    ViewData["Title"] = "Details";
}

<h1>Details</h1>

<div>
    <h4>Collection</h4>
    <hr />
    <dl class="row">
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Collection.Name)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Collection.Name)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Collection.Description)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Collection.Description)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Collection.DateStarted)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Collection.DateStarted)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Collection.ApplicationUser.FullName)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Collection.ApplicationUser.FullName)
        </dd>
        <dt class = "col-sm-2">
            Total Collection Items
        </dt>
        <dd class = "col-sm-10">
            @if (Model.Collection.CollectionItems.Any())
            {
                @(Model.Collection.CollectionItems?.Count ?? 0);
            }
            else
            {
                <span class="badge text-bg-warning">No Media in Collection</span>
            }
        </dd>
    </dl>
</div>
@if (Model.Collection.CollectionItems.Any())
{
    <h4>Items in @Model.Collection.Name:</h4>
    <table class="table table-bordered">
        <thead>
            <tr>
                <th>@Html.DisplayNameFor(model => model.Collection.CollectionItems[0].MediaItem.Title) </th>
                <th>@Html.DisplayNameFor(model => model.Collection.CollectionItems[0].MediaItem.MediaType.Type) </th>
                <th>@Html.DisplayNameFor(model => model.Collection.CollectionItems[0].MediaItem.MediaFormat.Format) </th>
                <th>@Html.DisplayNameFor(model => model.Collection.CollectionItems[0].DateAdded) </th>
                <th>@* placeholder for details hyperlink *@</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model.Collection.CollectionItems)
            {
                <tr>
                    <td>@Html.DisplayFor(modelItem => item.MediaItem.Title)</td>
                    <td>@Html.DisplayFor(modelItem => item.MediaItem.MediaType.Type)</td>
                    <td>@Html.DisplayFor(modelItem => item.MediaItem.MediaFormat.Format)</td>
                    <td>@Html.DisplayFor(modelItem => item.DateAdded)</td>
                    <td>
                        <a asp-page="/CollectionItemPages/Details" asp-route-id="@item.Id">Details</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
    <strong>@Model.Collection.CollectionItems.Count Collection Items(s) Found</strong>
}
else
{
    <div class="alert alert-warning">No items found in @Model.Collection.Name</div>
}
<div>
    <a asp-page="./Edit" asp-route-id="@Model.Collection.Id">Edit</a> |
    <a asp-page="./Index">Back to List</a>
</div>
