@page
@model MyMediaShelf.Pages.CollectionPages.IndexModel

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
    <a asp-page="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Collection[0].Name)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Collection[0].Description)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Collection[0].DateStarted)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Collection[0].ApplicationUser.FullName)
            </th>
            <th>
                Total Items in Collection
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model.Collection) {
        <tr>
            <td>
                @Html.DisplayFor(model => item.Name)
            </td>
            <td>
                @Html.DisplayFor(model => item.Description)
            </td>
            <td>
                @Html.DisplayFor(model => item.DateStarted)
            </td>
            <td>
                @Html.DisplayFor(model => item.ApplicationUser.FullName)
            </td>
            <td>
                    @if (item.CollectionItems.Any())
                    {
                        @(item.CollectionItems?.Count ?? 0);
                    }
                    else
                    {
                        <span class="badge text-bg-warning">No Media in Collection</span>
                    }
            </td>
            <td>
                <a asp-page="./Edit" asp-route-id="@item.Id">Edit</a> |
                <a asp-page="./Details" asp-route-id="@item.Id">Details</a> |
                <a asp-page="./Delete" asp-route-id="@item.Id">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
