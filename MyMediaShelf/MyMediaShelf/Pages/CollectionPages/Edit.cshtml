@page
@model MyMediaShelf.Pages.CollectionPages.EditModel

@{
    ViewData["Title"] = "Edit";
}

<h1>Edit</h1>

<h4>Collection</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="Collection.Id" />
            <div class="form-group">
                <span class="text-danger">*</span>
                <label asp-for="Collection.Name" class="control-label"></label>
                <input asp-for="Collection.Name" class="form-control" aria-required="true"/>
                <span asp-validation-for="Collection.Name" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Collection.Description" class="control-label"></label>
                <textarea asp-for="Collection.Description" class="form-control"></textarea>
                <span asp-validation-for="Collection.Description" class="text-danger"></span>
            </div>
            <div class="form-group">
                <span class="text-danger">*</span>
                <label asp-for="Collection.DateStarted" class="control-label"></label>
                <input asp-for="Collection.DateStarted" class="form-control" aria-required="true"/>
                <span asp-validation-for="Collection.DateStarted" class="text-danger"></span>
            </div>
            <div class="form-group">
                <input type="submit" value="Save" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-page="./Index">Back to List</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
