@page
@model MyMediaShelf.Pages.MediaFormatPages.IndexModel

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
    <a asp-page="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.MediaFormat[0].Format)
            </th>
            <th>
                Total Media Items
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model.MediaFormat) {
        <tr>
            <td>
                @Html.DisplayFor(model => item.Format)
            </td>
            <td>
                    @if (item.MediaItems.Any())
                    {
                        @(item.MediaItems?.Count ?? 0);
                    }
                    else
                    {
                        <span class="badge text-bg-warning">No Media Items</span>
                    }
                </td>
            <td>
                <a asp-page="./Edit" asp-route-id="@item.Id">Edit</a> |
                <a asp-page="./Details" asp-route-id="@item.Id">Details</a> |
                <a asp-page="./Delete" asp-route-id="@item.Id">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
